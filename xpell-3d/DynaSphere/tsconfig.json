{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,

    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "**/.vite",
    "**/.turbo",
    "**/.cache",
    "src/xvid.ts"
  ]
}
